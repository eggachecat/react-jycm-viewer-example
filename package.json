{
  "name": "react-jycm-viewer-example",
  "version": "0.1.0",
  "description": "Runnable React example for visualizing business-aware JYCM JSON diffs",
  "keywords": [
    "react",
    "webpack",
    "typescript",
    "json-diff",
    "semantic-diff",
    "jycm",
    "monaco-editor"
  ],
  "author": "eggachecat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggachecat/react-jycm-viewer-example.git"
  },
  "bugs": {
