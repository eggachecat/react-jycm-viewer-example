  },
  "homepage": "https://github.com/eggachecat/react-jycm-viewer-example",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && webpack --config=configs/webpack/prod.js",
    "lint": "eslint src --ext .ts,.tsx --quiet",
    "start": "webpack serve --config=configs/webpack/dev.js",
    "start-dev": "webpack serve --config=configs/webpack/dev.js",
    "start-prod": "node express.js",
    "test": "jest --coverage --runInBand --config=configs/jest.json",
    "check": "eslint src --ext .ts,.tsx --quiet && jest --coverage --runInBand --config=configs/jest.json && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && webpack --config=configs/webpack/prod.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.9",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@types/jest": "^27.4.1",
    "@types/node": "^17.0.24",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.14",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "babel-loader": "^8.2.4",
